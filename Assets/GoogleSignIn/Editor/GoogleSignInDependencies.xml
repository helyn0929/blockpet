<?xml version="1.0" encoding="UTF-8" ?>
<dependencies>
  <!-- See https://github.com/googlesamples/unity-jar-resolver#usage for
    how to configure dependencies -->
  <androidPackages>
    <androidPackage spec="com.google.android.gms:play-services-auth:16+">
      <androidSdkPackageIds>
        <androidSdkPackageId>extra-google-m2repository</androidSdkPackageId>
      </androidSdkPackageIds>
    </androidPackage>
  </androidPackages>

  <!-- iOS: GoogleSignIn pod disabled. This plugin (v1.0.4) only compiles against the legacy
       GoogleSignIn SDK 5.x, which conflicts with the Firebase 12 SwiftPM packages. The iOS native
       bridge (Assets/Plugins/iOS/GoogleSignIn) is also excluded and GOOGLE_SIGN_IN is undefined for
       iPhone, so Google login is unavailable on iOS until the plugin is upgraded.
  <iosPods>
    <iosPod name="GoogleSignIn" version=">= 4.0.2" bitcodeEnabled="false" minTargetSdk="6.0" />
  </iosPods>
  -->
</dependencies>
