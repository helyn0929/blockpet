/* =========================================
   Blockpet Market
   Reference panel: 1080 x 1920 (match height) — all sizes in px.
   Only USS properties supported by Unity 2022.3 are used here.
   ========================================= */

.mk-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(245, 245, 250);
}

/* ---------- HEADER ---------- */
.mk-header {
    flex-shrink: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 12px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(226, 232, 240);
}

.mk-back-btn {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 22px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.mk-back-btn:active {
    background-color: rgb(237, 233, 254);
}

.mk-back-icon {
    font-size: 30px;
    color: rgb(30, 41, 59);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    padding-bottom: 4px;
}

.mk-header-title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    -unity-text-align: middle-left;
    margin-left: 4px;
}

.mk-currency-bar {
    flex-direction: row;
    align-items: center;
}

.mk-currency-pill {
    flex-direction: row;
    align-items: center;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(245, 245, 250);
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    padding-left: 8px;
    padding-right: 12px;
    margin-left: 8px;
}

.mk-currency-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-currency-icon--coin {
    background-image: url("../Mainroom_UI/img_coins.png");
}

.mk-currency-emoji {
    font-size: 15px;
    margin: 0;
    padding: 0;
    margin-right: 4px;
}

.mk-currency-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    margin: 0;
    padding: 0;
}

/* ---------- STAGE ---------- */
.mk-stage {
    flex-shrink: 0;
    height: 340px;
    overflow: hidden;
    background-color: rgb(224, 231, 255);
    background-image: url("../Mainroom_UI/img_room.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: flex-end;
}

.mk-char-wrap {
    width: 240px;
    height: 240px;
    margin-bottom: 12px;
}

.mk-char-pet {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-char-accessories {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.mk-char-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-furniture {
    position: absolute;
    right: 32px;
    bottom: 20px;
    width: 150px;
    height: 150px;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-stage-chip {
    position: absolute;
    top: 12px;
    right: 12px;
    height: 32px;
    margin: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-width: 0;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.85);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.mk-stage-chip-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    margin: 0;
    padding: 0;
}

/* ---------- CATEGORY TABS ---------- */
.mk-tabs-scroll {
    flex-shrink: 0;
    height: 60px;
    background-color: rgb(245, 245, 250);
}

.mk-tabs {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding-left: 12px;
    padding-right: 12px;
}

.mk-tab {
    height: 38px;
    margin: 0;
    margin-right: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1.5px;
    border-color: rgb(203, 213, 225);
    border-radius: 19px;
    background-color: rgb(255, 255, 255);
    background-image: none;
    color: rgb(71, 85, 105);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.mk-tab--selected {
    background-color: rgb(99, 102, 241);
    border-color: rgb(99, 102, 241);
    color: rgb(255, 255, 255);
}

/* ---------- ITEM GRID ---------- */
.mk-grid-scroll {
    flex-grow: 1;
}

.mk-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 4px;
    padding-bottom: 16px;
    padding-left: 8px;
    padding-right: 8px;
}

.mk-section-header {
    width: 100%;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(100, 116, 139);
    margin-top: 10px;
    margin-bottom: 6px;
    margin-left: 8px;
}

.mk-card {
    width: 30%;
    height: 180px;
    margin-top: 0;
    margin-bottom: 12px;
    margin-left: 1.66%;
    margin-right: 1.66%;
    padding: 10px;
    border-width: 1.5px;
    border-color: rgb(226, 232, 240);
    border-radius: 16px;
    background-color: rgb(255, 255, 255);
    background-image: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.mk-card:active {
    background-color: rgb(248, 250, 252);
}

.mk-card--equipped {
    border-color: rgb(99, 102, 241);
    border-width: 2px;
}

.mk-card--locked {
    opacity: 0.45;
}

.mk-card-tile {
    width: 84px;
    height: 84px;
    border-radius: 16px;
    background-color: rgb(237, 233, 254);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.mk-card-tile--pets        { background-color: rgb(255, 228, 230); }
.mk-card-tile--accessories { background-color: rgb(219, 234, 254); }
.mk-card-tile--furnitures  { background-color: rgb(220, 252, 231); }
.mk-card-tile--money       { background-color: rgb(254, 243, 199); }

.mk-card-initial {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(99, 102, 241);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.mk-card-name {
    width: 100%;
    margin-top: 8px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    max-height: 34px;
}

.mk-card-price {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(100, 116, 139);
    -unity-text-align: middle-center;
}

.mk-card-price--free {
    color: rgb(22, 163, 74);
}

.mk-card-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: rgb(220, 252, 231);
    color: rgb(22, 163, 74);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mk-card-badge--equipped {
    background-color: rgb(99, 102, 241);
    color: rgb(255, 255, 255);
}

.mk-card-badge--locked {
    background-color: rgb(226, 232, 240);
    color: rgb(100, 116, 139);
}

/* ---------- ACTION BAR ---------- */
.mk-action-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 28px;
    padding-left: 20px;
    padding-right: 16px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgb(226, 232, 240);
}

.mk-action-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}

.mk-selected-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-selected-price {
    font-size: 12px;
    color: rgb(100, 116, 139);
    margin-top: 2px;
}

.mk-primary-btn {
    flex-shrink: 0;
    width: 140px;
    height: 48px;
    margin: 0;
    margin-left: 12px;
    padding: 0;
    border-width: 0;
    border-radius: 24px;
    background-color: rgb(99, 102, 241);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.mk-primary-btn:active {
    background-color: rgb(79, 70, 229);
}

.mk-primary-btn:disabled {
    background-color: rgb(203, 213, 225);
    opacity: 1;
}

.mk-primary-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
