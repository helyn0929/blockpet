<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MarketScreen.uss" />
    <ui:VisualElement name="market-root" class="mk-root">

        <!-- ─── Header ─────────────────────────────────────────────── -->
        <ui:VisualElement class="mk-header">
            <ui:Button name="btn-back" class="mk-back-btn">
                <ui:Label text="&#8249;" class="mk-back-icon" />
            </ui:Button>
            <ui:Label text="Market" class="mk-header-title" />
            <ui:VisualElement class="mk-currency-bar">
                <ui:VisualElement class="mk-currency-pill">
                    <ui:VisualElement class="mk-currency-icon mk-currency-icon--coin" />
                    <ui:Label name="coins-text" text="0" class="mk-currency-text" />
                </ui:VisualElement>
                <ui:VisualElement class="mk-currency-pill">
                    <ui:Label text="💎" class="mk-currency-emoji" />
                    <ui:Label name="gems-text" text="0" class="mk-currency-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ─── Stage: current room + character ──────────────────── -->
        <ui:VisualElement name="stage" class="mk-stage">
            <ui:VisualElement name="char-furniture" class="mk-furniture" />
            <ui:VisualElement name="char-wrap" class="mk-char-wrap">
                <ui:VisualElement name="char-pet" class="mk-char-pet" />
                <ui:VisualElement name="char-accessories" class="mk-char-accessories" />
            </ui:VisualElement>
            <ui:Button name="btn-reset" class="mk-stage-chip">
                <ui:Label text="Reset" class="mk-stage-chip-label" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ─── Category tabs ─────────────────────────────────────── -->
        <ui:ScrollView name="category-scroll" class="mk-tabs-scroll"
                        mode="Horizontal"
                        horizontal-scrollbar-visibility="Hidden"
                        vertical-scrollbar-visibility="Hidden">
            <ui:VisualElement name="category-list" class="mk-tabs" />
        </ui:ScrollView>

        <!-- ─── Item grid ─────────────────────────────────────────── -->
        <ui:ScrollView name="item-scroll" class="mk-grid-scroll"
                        horizontal-scrollbar-visibility="Hidden"
                        vertical-scrollbar-visibility="Hidden">
            <ui:VisualElement name="item-list" class="mk-grid" />
        </ui:ScrollView>

        <!-- ─── Bottom action bar ─────────────────────────────────── -->
        <ui:VisualElement class="mk-action-bar">
            <ui:VisualElement class="mk-action-info">
                <ui:Label name="selected-name" text="Select an item" class="mk-selected-name" />
                <ui:Label name="selected-price" text="" class="mk-selected-price" />
            </ui:VisualElement>
            <ui:Button name="btn-buyequip" class="mk-primary-btn">
                <ui:Label name="buy-equip-label" text="Buy" class="mk-primary-label" />
            </ui:Button>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
