/* =========================================
   佈置模式：下方家具列＋浮動按鈕
   PanelSettings 參考解析度 1080×1920（對齊高度），
   所以這裡的 px 約是設計稿（390 寬）的 2.3 倍。
   ========================================= */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    -unity-font: url("/Assets/Art/Fonts/NotoSansCJKtc-Bold.otf");
    color: rgb(58, 46, 34);
}

/* ─── Bottom panel ─────────────────────── */

.picker-panel {
    background-color: rgb(255, 248, 236);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    padding-top: 30px;
    padding-bottom: 56px;
    flex-direction: column;
}

.picker-header {
    flex-direction: row;
    align-items: center;
    padding-left: 34px;
    padding-right: 34px;
    margin-bottom: 18px;
}

.picker-titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.picker-title {
    font-size: 40px;
    padding: 0;
    margin: 0;
}

.picker-hint {
    font-size: 26px;
    color: rgb(122, 106, 88);
    white-space: normal;
    padding: 0;
    margin: 4px 0 0 0;
}

.done-btn {
    background-color: rgb(58, 46, 34);
    color: rgb(255, 248, 236);
    border-radius: 50px;
    border-width: 0;
    height: 100px;
    padding-left: 40px;
    padding-right: 40px;
    margin: 0 0 0 20px;
    font-size: 34px;
}

/* ─── Scroll row ───────────────────────── */

.item-scroll {
    height: 290px;
    flex-shrink: 0;
}

.item-container {
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    padding-right: 22px;
}

.item-btn {
    width: 190px;
    height: 270px;
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    border-width: 5px;
    border-color: rgba(246, 201, 69, 0);
    margin-left: 12px;
    margin-right: 12px;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    padding-top: 18px;
    padding-bottom: 12px;
}

.item-btn--selected {
    border-color: rgb(246, 201, 69);
    background-color: rgb(255, 244, 214);
}

.item-icon {
    width: 130px;
    height: 130px;
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.item-name {
    color: rgb(58, 46, 34);
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 8px;
    overflow: hidden;
    max-width: 170px;
}

.item-price {
    color: rgb(138, 122, 102);
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.empty-hint {
    display: none;
    font-size: 28px;
    color: rgb(138, 122, 102);
    -unity-text-align: middle-center;
    height: 290px;
}

/* ─── 浮動按鈕（跟著正在擺／選中的家具）── */

.action-bar {
    position: absolute;
    flex-direction: row;
    display: none;
}

.action-btn {
    height: 96px;
    padding-left: 36px;
    padding-right: 36px;
    margin: 0 8px;
    border-radius: 48px;
    border-width: 0;
    font-size: 32px;
    background-color: rgb(255, 248, 236);
    color: rgb(58, 46, 34);
}

.action-btn--main {
    background-color: rgb(246, 201, 69);
}

.action-btn--danger {
    background-color: rgb(232, 107, 79);
    color: rgb(255, 255, 255);
}
